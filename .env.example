# Application port
PORT=3000

# Environment mode (development | production)
NODE_ENV=development

# MongoDB connection string
# Example local URI: mongodb://localhost:27017/event-manager
# Example Atlas URI:
# mongodb+srv://<user>:<password>@cluster0.mongodb.net/event-manager?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/event-manager
# JWT secret key (use a strong, random value in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# JWT token expiration time (e.g., 7d for 7 days)
JWT_EXPIRES_IN=7d
# Bcrypt salt rounds for password hashing
BCRYPT_ROUNDS=10